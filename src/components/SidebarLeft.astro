---
import { github, linkedIn, youtube } from "../data/redesSociales.js";
import githubIcon from "../assets/iconos/github.svg";
import linkedinIcon from "../assets/iconos/linkedin.svg";
---

<aside class="sidebar-left">
  <!-- Profile Info -->
  <div class="profile-section">
    <div class="profile-image">
      <img
        src="https://avatars.githubusercontent.com/u/109451741?v=4"
        alt="Orlando Téllez - Full Stack Developer"
      />
    </div>
    <div class="profile-info">
      <h2 class="font-headline-sm profile-name">
        Orlando Téllez
        <span class="material-symbols-outlined verified-icon">verified</span>
      </h2>
      <p class="font-body-sm profile-bio">
        Full Stack Developer - TypeScript and Rust developer
      </p>
    </div>
  </div>

  <!-- Contact -->
  <div class="contact-section">
    <a href="/cv-orlandotellez.pdf" class="cv-btn" download>
      <span class="material-symbols-outlined">download</span>
      Descargar CV
    </a>
  </div>

  <!-- Footer Links -->
  <div class="sidebar-footer">
    <div class="footer-item">
      <img src={githubIcon.src} alt="GitHub" class="social-icon" />
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-body-sm link">github</a
      >
    </div>
    <div class="footer-item">
      <img src={linkedinIcon.src} alt="LinkedIn" class="social-icon" />
      <a
        href={linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        class="font-body-sm link">linkedIn</a
      >
    </div>
    <div class="footer-item">
      <img
        src="https://cdn.simpleicons.org/youtube/FFFFFF"
        alt="YouTube"
        class="social-icon"
      />
      <a
        href={youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="font-body-sm link">youtube</a
      >
    </div>
    <div class="footer-item">
      <span class="material-symbols-outlined contact-icon">mail</span>
      <a href="mailto:orlandogabrieltellez@gmail.com" class="font-body-sm link">
        orlandogabrieltellez@gmail.com
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar-left {
    display: none;
    flex-direction: column;
    gap: var(--spacing-stack-gap);
    padding: var(--spacing-gutter);
    width: var(--spacing-sidebar-width);
    flex-shrink: 0;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    border-right: 1px solid var(--color-outline-variant);
    border-left: 1px solid var(--color-outline-variant);
    background-color: var(--color-surface);
  }

  @media (min-width: 1024px) {
    .sidebar-left {
      display: flex;
    }
  }

  .profile-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .profile-image {
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--color-surface-container);
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-outline-variant);
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .profile-name {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .verified-icon {
    font-size: 18px;
    color: var(--color-primary);
    font-variation-settings: "FILL" 1;
  }

  .profile-bio {
    color: var(--color-on-surface-variant);
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .contact-icon {
    font-size: 18px;
    color: var(--color-on-surface-variant);
  }

  .cv-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 16px;
    background-color: var(--color-on-surface);
    color: var(--color-surface);
    border: none;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cv-btn:hover {
    opacity: 0.9;
  }

  .sidebar-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--color-outline-variant);
    padding-top: 16px;
  }

  .footer-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-on-surface-variant);
  }

  .social-icon {
    width: 18px;
    height: 18px;
    filter: var(--color-filter-on-surface-variant, none);
  }

  .link {
    color: var(--color-primary);
  }

  .link:hover {
    text-decoration: underline;
  }
</style>
