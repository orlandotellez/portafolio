---
const experience = [
  {
    role: "Desarrollador de páginas web autónomo",
    company: "Freelance",
    period: "nov. 2025 - Actualidad",
    duration: "7 meses",
    description:
      "Desarrollo y mantenimiento de sitios web para empresas locales e influencers. Incluye actualizaciones y gestión de proyectos.",
  },
  {
    role: "Desarrollador web",
    company: 'Hospital Militar Escuela Dr. "Alejandro Dávila Bolaños"',
    period: "jun. 2025 - dic. 2025",
    duration: "7 meses",
    location: "Managua, Nicaragua · Presencial",
    description:
      "Desarrollo frontend y backend, y desarrollo de aplicaciones móviles.",
  },
];

const tabCategories = [
  { id: "frontend", label: "Frontend" },
  { id: "backend", label: "Backend" },
  { id: "tools", label: "Herramientas" },
];

const techs = {
  frontend: [
    { name: "HTML5", color: "#E34F26" },
    { name: "CSS3", color: "#1572B6" },
    { name: "JavaScript", color: "#F7DF1E" },
    { name: "TypeScript", color: "#3178C6" },
    { name: "React", color: "#61DAFB", badgeColor: "#20232A" },
    { name: "Next.js", color: "#000000", badgeColor: "#F5F5F5" },
    { name: "React Native", color: "#61DAFB", badgeColor: "#20232A" },
    { name: "Expo", color: "#1C1E24" },
    { name: "Vite", color: "#646CFF" },
    { name: "Astro", color: "#000000" },
  ],
  backend: [
    { name: "Node.js", color: "#339933" },
    { name: "Fastify", color: "#000000", badgeColor: "#F5F5F5" },
    { name: "Express.js", color: "#404d59" },
    { name: "PostgreSQL", color: "#316192" },
    { name: "Rust", color: "#000000", badgeColor: "#F5F5F5" },
    {
      name: "Axum",
      color: "#000000",
      badgeColor: "#F5F5F5",
      img: "https://cdn.simpleicons.org/rust/000000",
    },
    { name: "Strapi", color: "#4945FF" },
  ],
  tools: [
    { name: "Git", color: "#F05032" },
    { name: "Tmux", color: "#1BB91F" },
    { name: "Linux", color: "#FCC624" },
    { name: "Neovim", color: "#57A143" },
  ],
};

function slug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]/g, "");
}
---

<aside class="sidebar-right">
  <!-- Experience -->
  <div class="card">
    <h3 class="card-title">Experiencia</h3>
    <div class="exp-list">
      {
        experience.map((exp) => (
          <div class="exp-item">
            <div class="exp-header">
              <h4 class="exp-role">{exp.role}</h4>
              <span class="exp-badge">{exp.duration}</span>
            </div>
            <div class="exp-company">{exp.company}</div>
            <div class="exp-period">{exp.period}</div>
            {exp.location && <div class="exp-location">{exp.location}</div>}
            <p class="exp-description">{exp.description}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Tech Stack with Tabs -->
  <div class="card">
    <h3 class="card-title">Stack</h3>
    <div class="tabs">
      {
        tabCategories.map((tab, i) => (
          <button
            class="tab-btn"
            class:list={{ active: i === 0 }}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    {
      tabCategories.map((tab) => {
        const isFirst = tabCategories.indexOf(tab) === 0;
        return (
          <div
            id={`tech-${tab.id}`}
            class="tech-panel"
            class:list={{ active: isFirst }}
          >
            <div class="tech-grid">
              {techs[tab.id].map((tech) => {
                const bc = tech.badgeColor || tech.color;
                const imgSrc =
                  tech.img ||
                  `https://cdn.simpleicons.org/${slug(tech.name)}/${tech.color.replace("#", "")}`;
                return (
                  <div
                    class="tech-item"
                    style={`background-color: ${bc}18; border: 1px solid ${bc}30;`}
                    title={tech.name}
                  >
                    <img alt={tech.name} src={imgSrc} />
                    <span class="tech-item-name">{tech.name}</span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Footer -->
  <footer class="sidebar-footer">
    <div class="footer-copyright">
      © {new Date().getFullYear()} Orlando Téllez
    </div>
  </footer>
</aside>

<script>
  document.querySelector(".tabs")?.addEventListener("click", (e) => {
    const btn = e.target.closest(".tab-btn");
    if (!btn) return;
    const tab = btn.dataset.tab;
    document
      .querySelectorAll(".tech-panel")
      .forEach((p) => p.classList.remove("active"));
    document
      .querySelectorAll(".tab-btn")
      .forEach((b) => b.classList.remove("active"));
    document.getElementById(`tech-${tab}`).classList.add("active");
    btn.classList.add("active");
  });
</script>

<style>
  .sidebar-right {
    display: none;
    flex-direction: column;
    gap: 24px;
    padding: var(--spacing-gutter);
    width: 320px;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    background-color: var(--color-surface);
    border-left: 1px solid var(--color-outline-variant);
    border-right: 1px solid var(--color-outline-variant);
    overflow-y: auto;
  }

  @media (min-width: 1280px) {
    .sidebar-right {
      display: flex;
    }
  }

  .card {
    background-color: #0f0f0f;
    border-radius: 5px;
    padding: 16px;
    border: 1px solid var(--color-outline-variant);
  }

  .card-title {
    margin-bottom: 16px;
    font-size: 16px;
    font-weight: 700;
  }

  /* Experience */
  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .exp-item {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .exp-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .exp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  .exp-role {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .exp-badge {
    font-size: 11px;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 15%, transparent);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .exp-company {
    font-size: 13px;
    color: var(--color-on-surface-variant);
    margin-bottom: 2px;
  }

  .exp-period,
  .exp-location {
    font-size: 12px;
    color: var(--color-on-surface-variant);
    line-height: 1.4;
  }

  .exp-description {
    font-size: 13px;
    color: var(--color-on-surface-variant);
    margin-top: 8px;
    line-height: 1.5;
  }

  /* Tabs */
  .tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
    background-color: #1a1a1a;
    border-radius: 5px;
    padding: 3px;
  }

  .tab-btn {
    flex: 1;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    background: transparent;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn.active {
    background-color: var(--color-on-surface);
    color: var(--color-surface);
  }

  .tech-panel {
    display: none;
  }

  .tech-panel.active {
    display: block;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 2px 4px;
    border-radius: 5px;
  }

  .tech-item img {
    width: 20px;
    height: 20px;
  }

  .tech-item-name {
    font-size: 8px;
    text-align: center;
    color: var(--color-on-surface-variant);
    line-height: 1.1;
    word-break: break-word;
    max-width: 100%;
  }

  /* Footer */
  .sidebar-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--color-outline-variant);
  }

  .footer-copyright {
    font-size: 12px;
    color: var(--color-on-surface-variant);
  }
</style>
