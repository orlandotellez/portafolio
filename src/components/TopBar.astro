---

---

<header class="topbar">
  <div class="container-topbar">
    <div class="topbar-left">
      <span class="logo-text font-headline-md">Portafolio Orlando Téllez</span>

      <span class="material-symbols-outlined verified-icon">verified</span>
    </div>
    <div class="topbar-right"></div>
  </div>
</header>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    padding: 0 var(--spacing-gutter);
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-surface);
    backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .container-topbar {
    width: 100%;
    margin: auto;
    max-width: var(--spacing-container-max);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-text {
    font-weight: 700;
    color: var(--color-primary);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .verified-icon {
    font-size: 18px;
    color: var(--color-primary);
    font-variation-settings: "FILL" 1;
  }
</style>
