---
interface Props {
  title: string;
  description: string;
  image: string;
  technologies: string[];
  slug: string;
  github?: string;
  url?: string;
  isHighlighted?: boolean;
}

const {
  title,
  description,
  image,
  technologies,
  slug,
  github,
  url,
  isHighlighted = false,
} = Astro.props;

const hasExternalUrl = !!url && !url.includes("github.com");
---

<article class={`feed-card project-card ${isHighlighted ? "" : ""}`}>
  <div class="card-content">
    <div class="card-image-container">
      <img class="card-image" src={image} alt={title} data-gallery />
    </div>
    <div class="card-info">
      <h3 class="font-headline-sm card-title">{title}</h3>
      <p class="font-body-sm card-description">{description}</p>
      <div class="card-tags font-code-label">
        {technologies.map((tech) => <span class="tag">{tech}</span>)}
      </div>
    </div>
  </div>
  <div class="card-actions">
    <a href={`/proyectos/${slug}`} class="btn-detail font-body-sm">
      <span class="material-symbols-outlined btn-act-icon">info</span>
      Ver detalles
    </a>
    <a
      href={url || "#"}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-project font-body-sm"
      style={!hasExternalUrl ? "display: none" : ""}
    >
      <span class="material-symbols-outlined btn-act-icon">open_in_new</span>
      Ver Proyecto
    </a>
    {
      github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-code font-body-sm"
        >
          <span class="material-symbols-outlined btn-act-icon">code</span>
          Código fuente
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    border-radius: 5px;
    overflow: hidden;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .card-content {
      flex-direction: row;
    }
  }

  .card-image-container {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: var(--color-surface-container);
    border-radius: 5px;
    border: 1px solid var(--color-outline-variant);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .card-image-container {
      width: 33.333%;
    }
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.5s ease;
  }

  .card-image-container:hover .card-image {
    transform: scale(1.05);
  }

  .card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-title {
    color: var(--color-primary);
  }

  .card-description {
    color: var(--color-on-surface-variant);
  }

  .card-tags {
    color: var(--color-tertiary);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag::before {
    content: "[";
  }

  .tag::after {
    content: "]";
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }

  .btn-detail,
  .btn-project,
  .btn-code {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 5px;
    text-align: center;
    font-weight: 600;
    font-size: 12px;
    text-decoration: none;
    min-width: 0;
    cursor: pointer;
  }

  .btn-act-icon {
    font-size: 15px;
  }

  /* Detail button - white filled */
  .btn-detail {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
  }

  .btn-detail:hover {
    opacity: 0.9;
  }

  /* Project button - gray filled */
  .btn-project {
    background-color: #2a2a2a;
    color: #e5e2e1;
    border: 1px solid #3a3a3a;
  }

  .btn-project:hover {
    background-color: #3a3a3a;
    border-color: #555555;
  }

  /* Code button - transparent outlined */
  .btn-code {
    background-color: transparent;
    color: var(--color-on-surface);
    border: 1px solid var(--color-outline-variant);
  }

  .btn-code:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--color-outline);
  }

  .card-engagement {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface-variant);
  }

  .engagement-stats {
    display: flex;
    gap: 16px;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .stat:hover {
    color: var(--color-primary);
  }

  .stat-repost:hover {
    color: #4ade80;
  }

  .stat-like:hover {
    color: #f87171;
  }

  .stat-icon {
    font-size: 16px;
  }

  .stat-views {
    display: flex;
    align-items: center;
    gap: 4px;
  }
</style>
