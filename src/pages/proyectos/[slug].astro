---
import fs from "fs";
import path from "path";
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import SidebarLeft from "../../components/SidebarLeft.astro";
import SidebarRight from "../../components/SidebarRight.astro";
import MobileNav from "../../components/MobileNav.astro";
import { proyectos, toSlug } from "../../data/proyectos.js";

export function getStaticPaths() {
  return proyectos.map((proj) => {
    const slug = toSlug(proj.subtitulo);
    return {
      params: { slug },
      props: { project: proj },
    };
  });
}

const { project } = Astro.props;
const slug = toSlug(project.subtitulo);
const hasExternalUrl = !!project.url && !project.url.includes("github.com");
const hasGithub = !!project.github;

// Detect images in project folder (e.g. /public/img/bookteka/1.webp, 2.webp, etc.)
const imgFolderPath = path.join(process.cwd(), "public", "img", slug);
let projectImages = [];

if (fs.existsSync(imgFolderPath)) {
  projectImages = fs
    .readdirSync(imgFolderPath)
    .filter((f) => /\.(webp|png|jpg|jpeg)$/i.test(f))
    .sort();
}

const hasProjectImages = projectImages.length > 1;
const coverImage = projectImages.includes("1.webp")
  ? `/img/${slug}/1.webp`
  : project.img;
const galleryImages = projectImages.filter((f) => f !== "1.webp");
---

<Layout title={`${project.subtitulo} | Orlando Téllez Portfolio`}>
  <TopBar />

  <main class="main-container">
    <SidebarLeft />

    <section class="project-detail">
      <!-- Back link -->
      <a href="/" class="back-link">
        <span class="material-symbols-outlined back-icon">arrow_back</span>
        Volver a proyectos
      </a>

      <!-- Hero image -->
      <div class="detail-hero">
        <img class="detail-image" src={coverImage} alt={project.subtitulo} />
      </div>

      <!-- Title & description -->
      <div class="detail-header">
        <h1 class="detail-title font-headline-sm">{project.subtitulo}</h1>
        <p class="detail-description">{project.texto}</p>
      </div>

      <!-- Tags -->
      <div class="detail-tags">
        {
          project.tecnologias.map((tech) => (
            <span class="detail-tag">{tech}</span>
          ))
        }
      </div>

      <!-- Action buttons -->
      <div class="detail-actions">
        {
          hasExternalUrl && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-detail btn-primary"
            >
              <span class="material-symbols-outlined btn-icon">
                open_in_new
              </span>
              Ver Proyecto
            </a>
          )
        }
        {
          hasGithub && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-detail btn-tertiary"
            >
              <span class="material-symbols-outlined btn-icon">code</span>
              Código fuente
            </a>
          )
        }
      </div>

      <!-- Extra detail sections -->
      <div class="detail-sections">
        <div class="detail-card">
          <h2 class="detail-card-title">
            <span class="material-symbols-outlined card-title-icon"
              >description</span
            >
            Descripción
          </h2>
          <p class="detail-card-text">
            {project.texto}
          </p>
        </div>

        <div class="detail-card">
          <h2 class="detail-card-title">
            <span class="material-symbols-outlined card-title-icon">layers</span
            >
            Tecnologías utilizadas
          </h2>
          <div class="detail-tech-list">
            {
              project.tecnologias.map((tech) => (
                <span class="detail-tech-item">{tech}</span>
              ))
            }
          </div>
        </div>

        {
          project.activeApp && project.releases && (
            <div class="detail-card">
              <h2 class="detail-card-title">
                <span class="material-symbols-outlined card-title-icon">
                  new_releases
                </span>
                Releases
              </h2>
              <p class="detail-card-text">
                Consulta las últimas versiones y notas de publicación en GitHub.
              </p>
              <a
                href={project.releases}
                target="_blank"
                rel="noopener noreferrer"
                class="releases-link"
              >
                <span class="material-symbols-outlined">open_in_new</span>
                Ver Releases en GitHub
              </a>
            </div>
          )
        }

        {
          hasProjectImages && (
            <div class="detail-card">
              <h2 class="detail-card-title">
                <span class="material-symbols-outlined card-title-icon">
                  photo_library
                </span>
                Imágenes
              </h2>
              <div class="detail-gallery">
                {galleryImages.map((img) => (
                  <img
                    class="gallery-image"
                    src={`/img/${slug}/${img}`}
                    alt={`${project.subtitulo} - ${img}`}
                    loading="lazy"
                    data-gallery
                  />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </section>

    <SidebarRight />
  </main>

  <MobileNav />

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button class="lightbox-close" aria-label="Cerrar">
      <span class="material-symbols-outlined">close</span>
    </button>
    <img id="lightbox-img" class="lightbox-image" alt="" />
  </div>
</Layout>

<style>
  .main-container {
    max-width: var(--spacing-container-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    padding-bottom: 80px;
  }

  @media (min-width: 1024px) {
    .main-container {
      flex-direction: row;
      padding-bottom: 0;
    }
  }

  .project-detail {
    flex: 1;
    max-width: 720px;
    margin: 0 auto;
    min-height: 100vh;
    padding: var(--spacing-gutter);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Back link */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--color-on-surface-variant);
    transition: color 0.2s ease;
    width: fit-content;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .back-icon {
    font-size: 18px;
  }

  /* Hero image */
  .detail-hero {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: var(--color-surface-container);
    border-radius: 5px;
    border: 1px solid var(--color-outline-variant);
    overflow: hidden;
  }

  .detail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Header */
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .detail-title {
    color: var(--color-primary);
    font-size: 28px;
  }

  .detail-description {
    font-size: 15px;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Tags */
  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .detail-tag {
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-tertiary);
    background-color: color-mix(
      in srgb,
      var(--color-tertiary) 12%,
      transparent
    );
    border: 1px solid color-mix(in srgb, var(--color-tertiary) 25%, transparent);
    border-radius: 5px;
  }

  /* Action buttons */
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-detail {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    min-width: 0;
  }

  .btn-icon {
    font-size: 18px;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-on-surface);
    border: 1px solid var(--color-outline-variant);
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-container);
  }

  .btn-tertiary {
    background-color: var(--color-on-surface);
    color: var(--color-surface);
  }

  .btn-tertiary:hover {
    opacity: 0.9;
  }

  /* Detail sections */
  .detail-sections {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }

  .detail-card {
    background-color: #0f0f0f;
    border-radius: 5px;
    padding: 20px;
    border: 1px solid var(--color-outline-variant);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .detail-card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 700;
  }

  .card-title-icon {
    font-size: 20px;
    color: var(--color-primary);
  }

  .detail-card-text {
    font-size: 14px;
    color: var(--color-on-surface-variant);
    line-height: 1.7;
  }

  .detail-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .detail-tech-item {
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: 5px;
  }

  .releases-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    background-color: var(--color-on-surface);
    color: var(--color-surface);
    border-radius: 5px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    width: fit-content;
  }

  .releases-link:hover {
    opacity: 0.9;
  }

  .releases-link span {
    font-size: 16px;
  }

  /* Gallery */
  .detail-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .gallery-image {
    width: 100%;
    border-radius: 5px;
    border: 1px solid var(--color-outline-variant);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .gallery-image:hover {
    opacity: 0.85;
  }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    padding: 24px;
    backdrop-filter: blur(4px);
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .lightbox-close:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .lightbox-close span {
    font-size: 28px;
  }
</style>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const closeBtn = document.querySelector(".lightbox-close");

  function openLightbox(src) {
    lightboxImg.src = src;
    lightboxImg.alt = src;
    lightbox.classList.add("open");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.remove("open");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  // Click on any gallery image
  document.addEventListener("click", (e) => {
    const img = e.target.closest("[data-gallery]");
    if (img) {
      e.preventDefault();
      openLightbox(img.src);
    }
  });

  // Close on X button
  closeBtn?.addEventListener("click", closeLightbox);

  // Close on click outside the image (on the backdrop)
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox?.classList.contains("open")) {
      closeLightbox();
    }
  });
</script>
