---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import SidebarLeft from "../components/SidebarLeft.astro";
import MainFeed from "../components/MainFeed.astro";
import SidebarRight from "../components/SidebarRight.astro";
import MobileNav from "../components/MobileNav.astro";
import { proyectos } from "../data/proyectos.js";
---

<Layout title="Orlando Téllez Portfolio">
  <TopBar />

  <main class="main-container">
    <SidebarLeft />
    <MainFeed projects={proyectos} />
    <SidebarRight />
  </main>

  <MobileNav />
</Layout>

<style>
  .main-container {
    max-width: var(--spacing-container-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    padding-bottom: 80px;
  }

  @media (min-width: 1024px) {
    .main-container {
      flex-direction: row;
      padding-bottom: 0;
    }
  }
</style>
